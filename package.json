{
  "name": "nechita-raka",
  "private": true,
  "type": "module",
  "description": "Student hub for first-year Computer Science and Brain Sciences students at Bar-Ilan University, with an AI chat per faculty",
  "scripts": {
    "check": "node scripts/check-data.mjs",
    "test": "node --test \"api/_tests/*.test.js\"",
