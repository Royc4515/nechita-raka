# Environment variables for the Vercel functions in api/. Set them in Vercel > Settings >
# Environment Variables, once per faculty project. Locally, `npx vercel dev` pulls the
# Development values; never use the Production values outside Production.
# Every variable is optional for the static site: without them the build works and the chat,
# the counters and the dashboard answer 503 instead of crashing.
# Details (in Hebrew): docs/EDITING.md, sections on the chat and the dashboard.

# --- Build ---
# Which faculty to build and serve: cs (default) or neuro. Required on every project except CS.
FACULTY=cs

# --- Chat (all three of GROQ_API_KEY, DATABASE_URL and CHAT_SALT are needed to turn it on) ---
# Groq API key from console.groq.com.
GROQ_API_KEY=
# Neon Postgres connection string; added automatically when Neon is connected in Vercel Storage.
# POSTGRES_URL is read as a fallback.
DATABASE_URL=
# Random string, at least 32 characters (64 recommended). Salts the hashed visitor counters.
CHAT_SALT=
# "false" turns the chat off (server-side kill switch).
CHAT_ENABLED=
# Comma-separated Groq model ids, up to 4; defaults are in api/_lib/chat/config.js.
CHAT_MODELS=
# "off" disables the prompt-guard model.
CHAT_GUARD=
# Daily caps, Preview only (simulations). Defaults: 150 for the site, 15 per visitor.
CHAT_GLOBAL_DAILY=
CHAT_PER_VISITOR_DAILY=
# Overrides the site address the chat links to; defaults to the faculty manifest's site.url.
SITE_URL=

# --- Admin dashboard (/admin) ---
# Google OAuth Web client id (ends in .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=
# Comma-separated emails allowed to sign in.
ADMIN_EMAILS=
# Optional, at least 32 random characters; derived from CHAT_SALT when unset.
ADMIN_SESSION_SECRET=

# --- Weekly email (Vercel cron, /api/cron/weekly) ---
# API key from resend.com; without it no email is sent.
RESEND_API_KEY=
# Optional recipient; defaults to the first ADMIN_EMAILS address.
REPORT_EMAIL=
# Optional sender address.
REPORT_FROM=
# Optional random string; when set, only Vercel cron can call the cron routes.
CRON_SECRET=

# --- Google Search Console sync (/api/cron/search-console), keyless via Workload Identity ---
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# The Search Console property, for example https://nechita-raka.vercel.app/
GSC_SITE_URL=

# --- Chat simulations against a protected Preview (scripts/simulate.mjs), local shell only ---
VERCEL_AUTOMATION_BYPASS_SECRET=
