{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["fra1"],
  "functions": {
    "api/chat.js": { "includeFiles": "{shared/data.js,faculties/*/data.js,faculties/*/faculty.js,faculties/*/courses/*.json}", "maxDuration": 30 },
    "api/track.js": { "includeFiles": "{shared/data.js,faculties/*/data.js,faculties/*/faculty.js,faculties/*/courses/*.json}", "maxDuration": 10 },
    "api/admin/*.js": { "includeFiles": "{shared/data.js,faculties/*/data.js,faculties/*/faculty.js,faculties/*/courses/*.json}", "maxDuration": 15 },
    "api/cron/*.js": { "includeFiles": "{shared/data.js,faculties/*/data.js,faculties/*/faculty.js,faculties/*/courses/*.json}", "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/search-console", "schedule": "0 4 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 5 * * *" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
